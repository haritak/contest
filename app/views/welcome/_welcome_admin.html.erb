

<div class="container">
  <h1 class="text-center my-2"> Εξαγωγές Αρχείων </h1>
  <table class="table table-striped table-hover">
    <tr>
      <td>
        Λίστα σχολείων
      </td>
      <td>
        <div data-turbo-prefetch="false">
          <% gf = GeneratedFile.where(user: current_user, purpose: "Teams::export_xlsx").last %>
          <% if gf %>
            <%= link_to "κατέβασμα xlsx που δημιουργήθηκε #{gf.updated_at}", download_exported_xlsx_teams_path, class: "link", data: {turbo: false} %>
          <% else %>
            δεν υπάρχει αρχείο
          <% end %>
        </div>
      </td>
      <td>
        <div data-turbo-prefetch="false">
          <%= link_to "έναρξη δημιουργίας xlsx", export_xlsx_teams_path, class: "btn btn-sm btn-outline-primary" %>
        </div>
      </td>
    </tr>


    <tr>
      <td>
        Λίστα αρχείων μαθητών/μαθητριών
      </td>
      <td>
        <div data-turbo-prefetch="false">
          <% gf = GeneratedFile.where(user: current_user, purpose: "StudentSubmissions::export_xlsx").last %>
          <% if gf %>
            <%= link_to "κατέβασμα xlsx που δημιουργήθηκε #{gf.updated_at}", download_exported_xlsx_student_submissions_path, class: "link", data: {turbo: false} %>
          <% else %>
            δεν υπάρχει αρχείο
          <% end %>
        </div>
      </td>
      <td>
        <div data-turbo-prefetch="false">
          <%= link_to "έναρξη δημιουργίας xlsx", export_xlsx_student_submissions_path, class: "btn btn-sm btn-outline-primary" %>
        </div>
      </td>
    </tr>
  </table>
  <h1 class="text-center my-2"> Ρυθμίσεις Ιστοτόπου </h1>
  <h2 class="text-center my-2"> Ώρα server: <%= DateTime.current.rfc822 %> </h2>
  <table class="table table-striped table-hover">
    <tr>
      <td>Αυτόνομο κατέβασμα αρχείων</td>
      <td><%= @site_setting.allow_autonomous_submissions? %></td>
      <td> <%= button_to "αλλαγή", welcome_switch_autonomous_submissions_path, form: {data: {turbo_confirm: "Να προχωρήσω στην αλλαγή;"}} %></td>
    </tr>
    <tr>
      <td>Απόκρυψη μαθητών/μαθητριών</td>
      <td><%= @site_setting.hide_students? %></td>
      <td> <%= button_to "αλλαγή", welcome_switch_hide_students_path, form: {data: {turbo_confirm: "Να προχωρήσω στην αλλαγή;"}} %></td>
    </tr>
    <tr>
      <td>Συνδιαχείριση λογαριασμού (με σύνδεση ως)</td>
      <td><%= @site_setting.enable_coadmin? %></td>
      <td> <%= button_to "αλλαγή", welcome_switch_enable_coadmin_path, form: {data: {turbo_confirm: "Να προχωρήσω στην αλλαγή;"}} %></td>
    </tr>
    <tr>
      <td>Γενική απενεργοποίηση previews</td>
      <td><%= @site_setting.shut_down_previews? %></td>
      <td> <%= button_to "αλλαγή", welcome_switch_shutdown_previews_path, form: {data: {turbo_confirm: "Να προχωρήσω στην αλλαγή;"}} %></td>
    </tr>
    <tr>
      <td>Ημερομηνία απενεργοποίησης συμμετοχής στο σεμινάριο</td>
      <td>
        <% if not @site_setting.date_to_deactivate_seminar_participation.present? %>
          δεν έχει οριστεί
        <% else %>
          <%= @site_setting.date_to_deactivate_seminar_participation %>
        <% end %>
      </td>
      <td>
        <%= form_with url: welcome_set_seminar_participation_deadline_path do |form| %>
          <%= form.datetime_local_field :date_to_deactivate_seminar_participation %>
          <%= form.submit "ορισμός" %>
        <% end %>
      </td>
    </tr>
    <tr>
      <td>
        <%= link_to "Τύποι Αρχείων Σχολικών Μονάδων", submission_types_url  %>
      </td>
      <td>
      </td>
      <td>
      </td>
    </tr>
    <tr>
      <td>
        <%= link_to "Τύποι Αρχείων Μαθητών/τριών", student_submission_types_url  %>
      </td>
      <td>
      </td>
      <td>
      </td>
    </tr>
    <tr>
      <td>
        <%= link_to "Στοιχεία Σχολείων Κρήτης", schools_url   %>
      </td>
      <td>
      </td>
      <td>
      </td>
    </tr>
    <tr>
      <td>
        <%= link_to "Κλάδοι/Ειδικότητες", specialities_url  %>
      </td>
      <td>
      </td>
      <td>
      </td>
    </tr>
    <tr>
      <td>
        <%= link_to "Τάξεις Σχολείων", school_classes_url  %>
      </td>
      <td>
      </td>
      <td>
      </td>
    </tr>
    <tr>
      <td>
        <%= link_to "Τύπο Σχολείων (δεν χρησιμοποιείται)", school_types_url  %>
      </td>
      <td>
      </td>
      <td>
      </td>
    </tr>
    <tr>
      <td>
        <%= link_to "Διευθύνσεις Σχολείων (δεν χρησιμοποιείται)", education_directorates_url  %>
      </td>
      <td>
      </td>
      <td>
      </td>
    </tr>
    <tr>
      <td>
        <%= link_to "Ετικέτες", tags_url  %>
      </td>
      <td>
      </td>
      <td>
      </td>
    </tr>
  </table>
</div>



