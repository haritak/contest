<div class="container my-2">
  <div class="row">
    <div class="col">



      <table class="table">
        <tr>
          <th>Τύπος αρχείου</th>
          <th>Σύνολο</th>
          <th>Μη Οριστ.</th>
          <th>Οριστικ.</th>
          <th>Ελεγμένα</th>
          <th>Για έλεγχο</th>
        </tr>
        <% SubmissionType.all.each do |st| %>
          <tr>
            <td>
              <%= st.submission_type %>
            </td>
            <td class="text-center">
              <%= all = Submission.where(submission_type_id: st.id).count %>
            </td>

            <td class="text-center">
              <%= all = Submission.not_finalized.where(submission_type_id: st.id).count %>
            </td>

            <td class="text-center">
              <%= fined = Submission.finalized.where(submission_type_id: st.id).count %>
            </td>

            <td class="text-center">
              <%= checked = Submission.finalized.reviewed.where(submission_type_id: st.id).count %>
            </td>

            <td class="text-center">
              <% if fined - checked > 0 %>
                <strong> <%= fined - checked %> </strong>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
      <div class="container d-flex justify-content-center my-2">
        <div class="row d-flex justify-content-center">
          <div class="d-flex justify-content-center mb-3">
      
            <%= link_to "Έλεγχος αρχείων σχολικών μονάδων", admin_index_submissions_url, 
              class: "btn btn-outline-primary" %>

          </div>
        </div>
      </div>

      <h3>Εγγραφές στην πλατφόρμα</h3>

      <table class="table table-striped">
        <tr>
          <td>
            Λογαριασμοί
          </td>
          <td>
            <%= User.count %> 
          </td>
        </tr>
        <tr>
          <td>
            Λογαριασμοί με Σχολείo
          </td>
          <td>
            <%= Team.count %> 
          </td>
        </tr>
        <tr>
          <td>
            Λογαριασμοί με Οριστική επιλογή Σχολείου
          </td>
          <td>
            <%= Team.finalized.count %> 
          </td>
        </tr>
        <tr>
          <td>
            υποβολές για το σεμινάριο
          </td>
          <td>
            <%= Team.seminar_participation_finalized.count %>
          </td>
        </tr>
        <tr>
          <td>
            υποβολές για τον διαγωνισμό
          </td>
          <td>
            <%= Team.participation_finalized.count %>
          </td>
        </tr>
      </table>

      <h3>Στοιχεία Μαθητών</h3>

      <table class="table table-striped">
        <tr>
          <td>
            Πλήθος μαθητών και μαθητριών
          </td>
          <td>
            <%= Student.count %>
          </td>
        </tr>

        <tr>
          <td>
            Πλήθος φωτογραφιών
          </td>
          <td>
            <%= StudentSubmission.optional.count %>
          </td>
        </tr>

        <% StudentSubmissionType.all.each do |sst| %>
          <tr>
            <td>
              Πλήθος <%= sst.name %>
            </td>
            <td>
              <%= StudentSubmission.where(student_submission_type_id: sst.id).count %>

              (οριστικοποιημένα: 
              <%= StudentSubmission.where(finalized: true, student_submission_type_id: sst.id).count %>
              )
              
            </td>
          </tr>
        <% end %>
      </table>
    </div>
  </div>
</div>
