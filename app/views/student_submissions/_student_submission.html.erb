<%= turbo_frame_tag student_submission do %>
  <div id="<%= dom_id student_submission %>">
    <% image_border = "border-bottom border-success-subtle" %>
    <div class="container-fluid <%= image_border %>">
      <div class="row row-cols-7 align-items-center">
        <div class="col"> <!-- column 1 -->
          <%= student_submission.student_submission_type.name %>
        </div>
        <div class="col text-center"> <!-- column 2 -->
          <% if student_submission.file.attached? %>
            <%# if not current_user and student_submission.file.representable? %>
              <%# image_tag student_submission.file.representation(resize_to_limit: [100,100]) %>
            <%# end %>
            <%= link_to student_submission.file.filename, 
              student_submission.file, data: {turbo: false}, target: "_blank" %> 
          <% else %>
            File not found!
          <% end %>
          <br/>
          <% if student_submission.optional? %>
            <% if @site_setting.shut_down_previews? %>
              <span title="Η προεπισκόπηση έχει απενεργοποιηθεί για λόγους απόδοσης του εξυπηρετητή">
                <small><small>[preview disabled]<br/></small></small>
              </span>
            <% else %>
              <%= turbo_frame_tag "review_preview_of_#{student_submission.id}", 
                src: thumbnail_student_submission_path(student_submission, thumb_size: 100), loading: :lazy do %>
                  (λήψη προεπισκόπησης)
                <% end %>
            <% end %>
          <% end %>
          <br/>
          <%= student_submission.title %>
        </div>
        <div class="col"> <!-- column 4 -->
          <% if current_user and student_submission.review_public %>
            <span class="badge rounded-pill text-wrap text-bg-info p-1">
              <%= student_submission.review_notes.presence %>
            </span>
          <% end %>
          <% if student_submission.file.analyzed? %>
            <% if student_submission.student_submission_type.optional? %>
              <% max_dimension_pixels = [student_submission.file.metadata['width'], student_submission.file.metadata['height']].max %>
              <% if max_dimension_pixels < 3000 %>
                <a class="badge text-bg-danger text-wrap" data-bs-toggle="collapse" href="#warn_dimensions_<%= student_submission.id %>" role="button" aria-expanded="false" aria-controls="warn_dimensions_<%= student_submission.id %>">
                  μικρές διαστάσεις <%= "#{student_submission.file.metadata['width']}x#{student_submission.file.metadata['height']}" %>
                </a>
                <div class="collapse" id="warn_dimensions_<%= student_submission.id %>">
                    Θα πρέπει η μεγαλύτερη πλευρά της φωτογραφίας σε pixel να μην είναι μικρότερη από 3000 pixel.
                    Στην συγκεκριμένη φωτογραφία που έχετε ανεβάσει θα πρέπει η πλευρά που είναι <%= max_dimension_pixels %> pixels να είναι τουλάχιστον 3000 pixel.
                </div>
              <% end %>
              <% if student_submission.file.byte_size < 2.megabytes %>
                <a class="badge text-bg-danger text-wrap" data-bs-toggle="collapse" href="#warn_filesize_<%= student_submission.id %>" role="button" aria-expanded="false" aria-controls="warn_filesize_<%= student_submission.id %>">
                  μικρό μέγεθος αρχείου <%= "#{student_submission.file.byte_size/1.kilobyte} KB" %>
                </a>
                <div class="collapse" id="warn_filesize_<%= student_submission.id %>">
                Το αρχείο είναι σχετικά μικρό σε μέγεθος. Θα πρέπει να είναι τουλάχιστον 2MB (2048 KB), ενώ αυτό που έχετε ανεβάσει είναι <%= student_submission.file.byte_size/1.kilobyte %> KB.
                </div>
              <% end %>
            <% else %>
              (αριθμός σελίδων: <%= student_submission.file.metadata['page_count'] %>)
            <% end %>
          <% else %>
            <span title="Ανανεώστε την σελίδα σας για ενημέρωση">
              <%= link_to "(ανάλυση αρχείου σε εξέλιξη)", student_submission %>
            </span>
          <% end %>
        </div>
        <% if current_user %>
          <div class="col align-center"> <!-- column 5 -->
            <% if current_user.is_admin? %>
              <%= render partial: "student_submissions/finalize_state", locals: {student_submission: student_submission} %>
              <%= link_to "Διόρθωση", edit_student_submission_path(student_submission), 
                type: "button", class: "btn btn-link link-dark btn-sm" %>
              <%= button_to "Διαγραφή", student_submission, method: :delete, 
              type: "button", class: "btn btn-link link-danger btn-sm", 
              form: {data: { turbo_confirm: 'Να προχωρήσω στην διαγραφή;', turbo_frame: "_top" }} %>
          <% elsif not student_submission.finalized? %>
            <%= button_to "Οριστικοποίηση", 
              make_final_student_submission_path(student_submission), 
              class: "btn btn-link link-success btn-sm", 
              form: {data: { turbo_confirm: 'Να προχωρήσω στην οριστικοποίηση;'}} %>
            <%= link_to "Διόρθωση", edit_student_submission_path(student_submission), 
              type: "button", class: "btn btn-link link-dark btn-sm" %>
            <%= button_to "Διαγραφή", student_submission, method: :delete, 
              type: "button", class: "btn btn-link link-danger btn-sm", 
              form: {data: { turbo_confirm: 'Να προχωρήσω στην διαγραφή;', turbo_frame: "_top" }} %>
          <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
