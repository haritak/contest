<div id="<%= dom_id person %>">
  <strong><%= person.last_name %> <%= person.first_name %></strong>
  <%= person.father_name %>
  <%= person.mother_name %>
  <%= person.gender_to_s %>
  <%= link_to number_to_phone( person.contact_phone ), "tel:#{person.contact_phone}"%>
  <%= link_to person.contact_email, "email:#{person.contact_email}"%></email>
  <% if current_user&.is_admin? %>
    <strong> Created by:</strong> <%= person.user.email %><br/>
  <% end %>
</div>
