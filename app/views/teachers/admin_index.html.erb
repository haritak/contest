<h1>Οριστικοποιημένοι Εκπαιδευτικοί (<%= @teachers.count %>)</h1>

<div id="teachers">
  <table class="table table-striped table-hover">
    <tr>
      <th> teachid </th>
      <th>Σχολείο (λογ. πλατφ.)</th>
      <th>Επώνυμο</th>
      <th>Όνομα</th>
      <th>Ειδικότητα</th>
      <th>Τηλέφωνο επικοινωνίας</th>
      <th>Email επικοινωνίας</th>
      <% if current_user.is_admin? %>
        <th>ενέργειες</th>
      <% end %>
    </tr>
    <% @teachers.each do |teacher| %>
      <tr>
        <td> <%= teacher.id %> </td>
        <td> 
          <%= teacher.school %> <br/>
          (<%= teacher.user.email %>)
        </td>
        <td> <%= teacher.person.last_name %> </td>
        <td> <%= teacher.person.first_name %> </td>
        <td> <%= teacher.speciality %> </td>
        <td> <%= phone_to teacher.person.contact_phone %> </td>
        <td> <%= mail_to teacher.person.contact_email %> </td>
        <% if current_user.is_admin? %>
          <td class="text-center"> 
            <%= link_to "Προβολη", teacher, class: "btn btn-sm btn-outline-primary" %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </table>
</div>
