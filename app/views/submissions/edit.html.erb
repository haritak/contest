<h1>Editing submission</h1>

<%= turbo_frame_tag @submission do %>
  <div class="container mb-4 bg-body-secondary border border-secondary rounded">
    <h3>Διόρθωση αρχείου Σχολικής Μονάδας</h3>
    <%= render "form", submission: @submission %>
  </div>
<% end %>

<% if current_user.is_admin? %>
<div>
  <%= link_to "Show this submission", @submission %> |
  <%= link_to "Back to submissions", submissions_path %>
</div>
<% end %>
