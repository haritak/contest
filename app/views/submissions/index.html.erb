<div id="submissions" class="container my-2">

  <%= turbo_frame_tag "user_submissions_header" do %>
    <%= render partial:"submissions/submissions_header", locals: { current_user: current_user }%>
  <% end %>

  <%= turbo_frame_tag Submission.new %>

  <%= turbo_frame_tag "user_submissions" do %>
    <% @submissions.each do |s| %>
      <%= render s %>
    <% end %>
  <% end %>

  <div class="container d-flex justify-content-center my-2">
    <div class="row d-flex justify-content-center">
      <div class="d-flex justify-content-center mb-3">
        <%= link_to "Πίσω", :back, class: "btn btn-outline-success" %>
      </div>
    </div>
  </div>
</div>
