<%# locals: (submission:) -%>

<%= form_with(model: submission) do |form| %>
  <% if submission.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <ul>
        <% submission.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="container mb-2">
    <div class="row">
      <div class="col">
        <strong>Περιεχόμενο αρχείου<br/></strong>
        <%= form.collection_select :submission_type_id, SubmissionType.mandatory, :id, :submission_type,
          {include_blank: true} %> 
      </div>
      <div class="col">
        <strong><% if submission.submission_file.attached? and submission.submission_file.persisted? %>
          Τρέχων αρχείο: <%= link_to submission.submission_file.filename, submission.submission_file %> <br/>
        <% else %>
          Αρχείο προς υποβολή
        <% end %></strong>
      <%= form.file_field :submission_file %> <!-- , accept: 'application/pdf'  -->
      </div>
      <div class="col">
        Σημειώσεις<br/>
        <%= form.text_area :submission_description %>
      </div>
    </div>
    <div class="row">
      <div class="col-3">
        <div class=row><div class=col>
            <%= form.submit "Υποβολή", class: "btn btn-sm btn-outline-primary" %>
            <% if submission.persisted? %>
              <%= link_to "Άκυρο", submission, class: "btn btn-sm btn-outline-danger" %>
            <% else %>
              <%= link_to "Άκυρο", submissions_path, class: "btn btn-sm btn-outline-danger" %>
            <% end %>
          </div></div>
      </div>
    </div>
  </div>
<% end %>
