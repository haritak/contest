<div id="<%= dom_id team %>" class="container mb-5">
  <div class="row">
    <div class="col d-flex justify-content-center">
      <button type="button" 
              class="btn btn-outline-dark position-relative mb-1"
              data-bs-toggle="collapse" data-bs-target="#school_approval_status" aria-expanded="false" aria-controls="school_approval_status">
        <h2><%= team.school.name %> </h2>
        <% if team.finalized? and current_user and current_user == team.user %>
          <% if not current_user.team.participation_finalized? %>
            <% if team.school_approved? %>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary"
                    title="Έχει γίνει επιβεβαιώση του λογαριασμού από το σχολείο">
                Επιβ.
              </span>
            <% else %>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning"
                   title="Έχει σταλεί ένα email στο επίσημο email του σχολείου για επιβεβαίωση δημιουργίας λογαριασμού">
                Σε αναμονή επιβεβ.
              </span>
            <% end %>
          <% end %>
        <% end %>
      </button>
    </div>
  </div>
  <div class="collapse" id="school_approval_status">
    <div class="row">
      <div class="col text-center">
        <% if team.finalized? and current_user and current_user == team.user %>
          <% if not current_user.team.participation_finalized? %>
            <% if team.school_approved? %>
              Έχει γίνει από το σχολείο επιτυχής επιβεβαιώση δημιουργίας του λογαριασμού στην πλατφόρμα.
            <% else %>
              Έχει σταλεί ένα email στο επίσημο email του σχολείου προκειμένου να γίνει επιβεβαίωση δημιουργίας λογαριασμού στην πλατφόρμα.
            <% end %>
          <% end %>
        <% end %>
        <% if not team.finalized? %>
          Παρακαλούμε προχωρήστε στην οριστικοποίηση των στοιχείων του σχολείου, προκειμένου να μπορείτε να προσθέσε εκπαιδευτικό.
        <% end %>
      </div>
    </div>
  </div> <!--row-->
  <div class="row">
    <div class="col d-flex justify-content-center">
      <button class="btn btn-sm btn-outline-dark" 
              type="button" 
              data-bs-toggle="collapse" data-bs-target="#team_details" aria-expanded="false" aria-controls="team_details">
        πληροφορίες
      </button>
    </div>
  </div>
  <div class="collapse" id="team_details">
    <div class="row">
      <div class="col text-center">
        <h4>Στοιχεία επικοινωνίας</h4>
        <% if team.school %>
          <p>
          Επίσημα στοιχεία επικοινωνίας<br/>
          Τηλέφωνο: <%= phone_to team.school.contact_phone %><br/>
          Email: <%= mail_to team.school.contact_email %></li>
          </p>
        <% end %>
        <p>
        Όπως δηλώθηκαν στην πλατφόρμα<br/>
        Τηλέφωνο: <%= phone_to team.contact_phone %>,<br/> 
        Email: <%= mail_to team.contact_email %>
        </p>
      </div>
      <% if not team.finalized? and current_user and !current_user.is_admin? %>
        <div class="col text-center">
          <%= link_to "Διόρθωση", edit_team_path(team), type: "button", class: "btn btn-sm btn-outline-dark" %>
          <%= button_to "Διαγραφή", team, method: :delete, type: "button", class: "btn btn-sm btn-outline-danger", 
            form: {data: { turbo_confirm: 'Να προχωρήσω στην διαγραφή;' }}%>
        </div>
      <% end %>
    </div>
    <div class="col">
      <% if current_user&.is_admin? %>
        <li> <strong>Υποβλήθηκε από:</strong> <%= team.user.email %> </li>
        <li>
          <strong>Οριστικοποιημένη;</strong> <%= team.finalized? %><br/>
          <strong>Ημερομηνία:</strong> <%= team.finalized_date %><br/>
          <% if team.finalized? %>
            <%= button_to 'Αφαίρεση οριστικοποίησης (στοιχείων ομάδας)', unfinalize_team_path(team) %>
          <% end %>
          <% if team.participation_finalized? %>
            <%= button_to 'Αφαίρεση οριστικοποίησης συμμετοχής', unfinalize_participation_user_path(team.user) %>
          <% end %>
        </li>
      <% end %>
    </div>
  </div> <!--row-->
  <div class="row mt-2">
    <div class="col d-flex justify-content-center">
      <% if not team.finalized? and current_user and !current_user.is_admin? %>
        <span title="Οριστοκοποίηση (κλείδωμα) των στοιχείων του σχολείου">
          <%= button_to "οριστικοποίηση", make_final_team_path(team), class: "btn btn-outline-success", form: { class: "align-self-center", data: {turbo_confirm: 'Να προχωρήσω στην οριστικοποίηση; Θα σταλεί ένα email προς το σχολείο για την επιβεβαίωση δημιουργίας λογαριασμού στην πλατφόρμα.', turbo_frame: "_top"}} %>
        </span>
      <% end %>
    </div>
  </div>
</div>
