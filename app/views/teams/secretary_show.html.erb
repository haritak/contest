<h1> <%= @team.school.name %></h1>
<h2> Επίσημα Στοιχεία </h2>
Email: <%= @team.school.contact_email %></br>
Τηλέφωνο: <%= @team.school.contact_phone %>
  <h2> Στοιχεία που δηλώθηκαν στην πλατφόρμα </h2>
  Email: <%= @team.contact_email %></br>
  Τηλέφωνο: <%= @team.contact_phone %>
<h2> Λογαριασμός στην πλατφόρμα</h2>
<%= @team.user.email %>
<h2>Εκπαιδευτικοί</h2>
<% @team.user.teachers.each do |t| %>
  <%= render t %>
<% end %>

<div class="container d-flex justify-content-center my-2">
  <div class="row d-flex justify-content-center">
    <div class="d-flex justify-content-center mb-3">
      <%= link_to "Πίσω", :back, class: "btn btn-outline-success" %>
    </div>
  </div>
</div>
