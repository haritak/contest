<%= turbo_frame_tag "tags_menu" do %>

  <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
    <% if session[:current_tag_id].present? %>
      <% current_tag = Tag.find(session[:current_tag_id]) %>
      Τρέχουσα ετικέτα για άμεση εφαρμογή: <%= current_tag.name %>
    <% else %>
        Δεν έχει επιλεγεί τρέχουσα ετικέτα για άμεση εφαρμογή
    <% end %>
  </a>
  <ul class="dropdown-menu">
    <% Tag.of_user_or_global(current_user).each do |tag| %>
      <li class="nav-item">
        <%= button_to "#{tag.name}", set_active_tag_path(tag), class: "nav-link", style: "color: #{tag.color}" %>
      </li>
    <% end %>
  </ul>
<% end %>
